{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./*"],
            "@api/*": ["./api/*"],
            "@assets/*": ["./assets/*"],
            "@components/*": ["./components/*"],
            "@features/*": ["./features/*"],
            "@lib/*": ["./lib/*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "nativewind-env.d.ts"
    ]
}
