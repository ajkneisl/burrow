<configuration>
    <timestamp key="byDay" datePattern="yyyyMMdd'T'HHmmss"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%boldWhite(%d{"yyyy/MM/dd HH:mm:ss", America/Chicago}) %highlight(%-5level) %boldYellow(%logger{0}) %marker: %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <root level="ERROR">
        <appender-ref ref="STDOUT"/>
    </root>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>

    <root level="DEBUG">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="org.eclipse.netty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
    <logger name="reactor.netty" level="INFO"/>
    <logger name="reactor.core" level="INFO"/>
    <logger name="io.r2dbc.postgresql" level="INFO"/>
    <logger name="Exposed" level="INFO"/>
</configuration>